PORT=3000

# Credencial de Firebase Admin (una de las dos):
# - local: ruta al JSON descargado (fuera del repo)
FIREBASE_SERVICE_ACCOUNT_PATH=C:\ruta\al\gen-on-xxxx-firebase-adminsdk.json
# - App Platform: el JSON completo (o en base64) como variable secreta
# FIREBASE_SERVICE_ACCOUNT=

# Clave para cifrar tokens y secretos de Meta (32 bytes en base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=

# URL pública de esta API (para armar la URL del webhook de cada organización)
PUBLIC_API_URL=http://localhost:3000

# Orígenes permitidos (CORS), separados por coma
WEB_ORIGINS=http://localhost:5173

META_GRAPH_VERSION=v22.0

# Despachador de la parrilla (cada minuto). Solo en producción: local y
# producción usan la misma base y un backend local no debe enviar mensajes.
DISPATCH_ENABLED=false
# Opcional: solo despachar estas organizaciones (separadas por coma). Para
# encenderlo en local sin tocar las clínicas reales, p. ej. al grabar la demo.
# DISPATCH_ORG_IDS=
