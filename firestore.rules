rules_version = '2';

// Todas las escrituras pasan por la API (firebase-admin ignora estas reglas).
// Desde el navegador solo se lee lo de las organizaciones a las que la
// persona tiene acceso, para las vistas en tiempo real (alertas, bandeja).
// org_secrets y la ficha clínica nunca son legibles.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isSuperadmin() {
      return signedIn() && request.auth.token.role == 'superadmin';
    }
    // Acceso a la organización: su documento en members (equipo de la
    // clínica o equipo Gen.iality asignado)
    function isMember(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    match /organizations/{orgId} {
      allow read: if isSuperadmin() || isMember(orgId);

      // La ficha clínica no se lee desde el navegador: solo por la API, que
      // revisa el rol de salud y deja registro de cada consulta
      match /{sub}/{rest=**} {
        allow read: if (isSuperadmin() || isMember(orgId))
          && !(sub in ['clinical_records', 'clinical_notes', 'clinical_access']);
      }
    }

    match /users/{uid} {
      allow read: if isSuperadmin() || (signedIn() && request.auth.uid == uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
